# WhisprLink environment template — placeholders only.
APP_ENV=development
LOG_LEVEL=INFO
BOT_MODE=polling

# Obtain a token from BotFather for local development only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Disposable local services; replace credentials for your environment.
DATABASE_URL=postgresql+asyncpg://whisprlink:change-me@localhost:5432/whisprlink
REDIS_URL=redis://localhost:6379/0

# Distinct strong random values; never reuse the Telegram token.
DEEP_LINK_SECRET=
WEBHOOK_SECRET_TOKEN=
WEBHOOK_BASE_URL=

# Retention is a policy decision to finalize before public launch.
DATA_RETENTION_DAYS=30
