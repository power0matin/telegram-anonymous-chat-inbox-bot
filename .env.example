# WhisprLink environment template. Placeholders only; never commit a real .env.

# --- Runtime ---------------------------------------------------------------------------------
APP_ENV=development            # development | test | production (production enforces strict checks)
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=console             # console | json (use json in production)
BOT_MODE=polling               # only "polling" is implemented

# --- Telegram --------------------------------------------------------------------------------
# Token from BotFather. Use a separate bot for development.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# Comma-separated numeric Telegram user IDs allowed to use admin features (production requires
# at least one). Example: ADMIN_TELEGRAM_IDS=111111111,222222222
ADMIN_TELEGRAM_IDS=

# Keyed-hash secret for inbox link tokens. Required in production, at least 32 characters, and
# different from the bot token. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEEP_LINK_SECRET=

# --- PostgreSQL (authoritative store) ----------------------------------------------------------
# Must use the postgresql+asyncpg:// scheme. Production rejects placeholder passwords.
DATABASE_URL=postgresql+asyncpg://whisprlink:change-me@localhost:5432/whisprlink
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_COMMAND_TIMEOUT_SECONDS=30
# PostgreSQL terminates sessions idle inside a transaction longer than this.
DB_IDLE_IN_TRANSACTION_TIMEOUT_SECONDS=30

# --- Redis (ephemeral coordination only; never authoritative) ----------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_POOL_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_RETRY_ATTEMPTS=3

# --- Startup, health, liveness -----------------------------------------------------------------
STARTUP_RETRY_ATTEMPTS=10
STARTUP_RETRY_DELAY_SECONDS=2
HEALTH_CHECK_TIMEOUT_SECONDS=5
HEARTBEAT_PATH=/tmp/whisprlink.heartbeat
HEARTBEAT_INTERVAL_SECONDS=15
HEARTBEAT_MAX_AGE_SECONDS=60

# --- Reserved ----------------------------------------------------------------------------------
# Reserved: no retention job exists yet. Phase 6 replaces this with per-category periods.
DATA_RETENTION_DAYS=30
